{
  "name": "purgeai",
  "version": "1.0.0",
  "workspaces": ["client", "server", "db"],
  "description": "PurgeAI is a battle tested AI assistant designed and developed to help devs manage and review their PRs efficiently",
  "scripts": {
    "web": "bun --filter client dev",
    "api": "bun --filter server dev",
    "db:up": "docker compose -f db/docker-compose.yml up -d",
    "db:seed": "bun --filter db seed",
    "db:generate": "bun --filter db generate",
    "db:migrate": "bun --filter db migrate",
    "server-img": "docker build -f docker/Dockerfile.server -t purgeaiserver:1.0 .",
    "test": "cd client && bun run lint",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "Abdullah Mukri",
  "license": "ISC",
  "packageManager": "bun@1.4.5",
  "dependencies": {
    "husky": "^9.1.7"
  }
}
